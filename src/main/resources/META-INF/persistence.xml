<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="jpa-hibernate-sqlserver" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <!-- Khai báo các Entity -->
        <class>vn.iotstar.entity.Category</class>
        <class>vn.iotstar.entity.Video</class>
        <class>vn.iotstar.entity.User</class>
        <class>vn.iotstar.entity.Product</class>

        <properties>
            <!-- 1. Driver MySQL -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            
            <!-- 2. Chuỗi kết nối MySQL (Đổi tên db nếu khác) -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/ltwebdb?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"/>
            
            <!-- 3. Tài khoản và mật khẩu MySQL Workbench/XAMPP của bạn -->
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="mysql2006@"/> <!-- Đổi thành pass root của bạn (nếu dùng XAMPP thì để trống "") -->

            <!-- 4. Hibernate Dialect cho MySQL -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>